{
  "pack_version": 1,
  "id": "discord",
  "name": "Discord",
  "description": "Voice and navigation for Discord: mute, deafen, quick switcher, channel and server switching and unread jumps on the 15-key module; the encoder mutes your microphone.",
  "app": {
    "name": "Discord",
    "bundle_id": "com.hnc.Discord"
  },
  "license": "CC0-1.0",
  "source": "Written for OpenStreamHub from Discord's default macOS shortcuts, as the vendor documents them. Not checked on a Mac yet; edit any that changed. They work while Discord is in front, which is when the focus rule activates this profile; for mute from other apps, set a global keybind in Discord.",
  "verified": false,
  "focus_rule": {
    "bundle_id": "com.hnc.Discord"
  },
  "profile": {
    "schema_version": 2,
    "name": "Discord",
    "bindings": [
      {
        "module": "m131e",
        "control": 0,
        "gesture": "pressed",
        "action": {
          "type": "shortcut",
          "key": "m",
          "modifiers": [
            "command",
            "shift"
          ]
        }
      },
      {
        "module": "m131e",
        "control": 0,
        "gesture": "right",
        "action": {
          "type": "volume",
          "delta": 5
        }
      },
      {
        "module": "m131e",
        "control": 0,
        "gesture": "left",
        "action": {
          "type": "volume",
          "delta": -5
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "clockwise",
        "action": {
          "type": "volume",
          "delta": 5
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "counter_clockwise",
        "action": {
          "type": "volume",
          "delta": -5
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "pressed",
        "action": {
          "type": "shortcut",
          "key": "d",
          "modifiers": [
            "command",
            "shift"
          ]
        }
      }
    ],
