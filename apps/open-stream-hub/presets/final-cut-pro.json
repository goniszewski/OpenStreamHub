              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "o",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Marker",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "m",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Select tool",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "a",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
