{
  "pack_version": 1,
  "id": "final-cut-pro",
  "name": "Final Cut Pro",
  "description": "Transport, the blade and the edit commands for Final Cut Pro: the encoder steps frames, a knob shuttles with J, K and L, and the 15-key module holds append, insert, overwrite and the tools.",
  "app": {
    "name": "Final Cut Pro",
    "bundle_id": "com.apple.FinalCut"
  },
  "license": "CC0-1.0",
  "source": "Written for OpenStreamHub from Final Cut Pro's default macOS keyboard shortcuts, as the vendor documents them. Not yet checked against the application on a Mac: shortcuts differ between versions, and a changed one can be edited in the profile.",
  "verified": false,
  "focus_rule": {
    "bundle_id": "com.apple.FinalCut"
  },
  "profile": {
    "schema_version": 2,
    "name": "Final Cut Pro",
    "bindings": [
      {
        "module": "m131e",
        "control": 0,
        "gesture": "right",
        "action": {
          "type": "shortcut",
          "key": "arrow_right",
          "modifiers": []
        }
      },
      {
        "module": "m131e",
        "control": 0,
        "gesture": "left",
        "action": {
          "type": "shortcut",
          "key": "arrow_left",
          "modifiers": []
        }
      },
      {
        "module": "m131e",
        "control": 0,
        "gesture": "pressed",
        "action": {
          "type": "shortcut",
          "key": "space",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "clockwise",
        "action": {
          "type": "shortcut",
          "key": "l",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "counter_clockwise",
        "action": {
          "type": "shortcut",
          "key": "j",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 0,
        "gesture": "pressed",
        "action": {
          "type": "shortcut",
          "key": "k",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 1,
        "gesture": "clockwise",
        "action": {
          "type": "shortcut",
          "key": "arrow_down",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 1,
        "gesture": "counter_clockwise",
        "action": {
          "type": "shortcut",
          "key": "arrow_up",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 1,
        "gesture": "pressed",
        "action": {
          "type": "shortcut",
          "key": "m",
          "modifiers": []
        }
      },
      {
        "module": "m003k",
        "control": 2,
        "gesture": "clockwise",
        "action": {
          "type": "volume",
          "delta": 5
        }
      },
      {
        "module": "m003k",
        "control": 2,
        "gesture": "counter_clockwise",
        "action": {
          "type": "volume",
          "delta": -5
        }
      },
      {
        "module": "m003k",
        "control": 2,
        "gesture": "pressed",
        "action": {
          "type": "toggle_mute"
        }
      },
      {
        "module": "m005s",
        "control": 0,
        "gesture": "position_changed",
        "action": {
          "type": "volume_from_position"
        }
      }
    ],
    "keypad": {
      "pages": [
        {
          "id": "root",
          "name": "Root",
          "slots": [
            {
              "type": "action",
              "label": "Append",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "e",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Insert",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "w",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
