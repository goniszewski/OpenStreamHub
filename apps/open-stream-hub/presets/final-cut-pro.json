              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "t",
                    "modifiers": []
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Snapping",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "n",
                    "modifiers": []
