                    "command": "undo"
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Redo",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "system",
                    "command": "redo"
                  }
                }
              ]
