                    "key": "g",
                    "modifiers": [
                      "command",
                      "shift"
                    ]
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Outline view",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "shortcut",
                    "key": "y",
                    "modifiers": [
                      "command"
                    ]
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Undo",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "system",
                    "command": "undo"
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Redo",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "system",
                    "command": "redo"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
