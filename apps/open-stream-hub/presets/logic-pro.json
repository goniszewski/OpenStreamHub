                }
              ]
            },
            {
              "type": "action",
              "label": "Redo",
              "bindings": [
                {
                  "gesture": "pressed",
                  "action": {
                    "type": "system",
                    "command": "redo"
                  }
                }
              ]
            },
            {
              "type": "action",
              "label": "Screenshot",
              "bindings": [
                {
                  "gesture": "pressed",
