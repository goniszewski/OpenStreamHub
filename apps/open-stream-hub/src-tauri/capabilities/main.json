{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local profile editing, device-free replay, and read-only device input feeds, supervised masterhub-service action runs with sleep/wake and reconnect sessions, local diagnostic bundles, opt-in focused-app profile rules, offline display artwork preparation, and the opt-in experimental module display setting in the main window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-bootstrap",
    "allow-list-profiles",
    "allow-load-profile",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-validate-profile",
    "allow-export-profile",
    "allow-replay-demo",
    "allow-preview-binding",
    "allow-preview-keypad",
    "allow-list-live-devices",
    "allow-start-feed",
    "allow-stop-feed",
    "allow-start-service",
    "allow-stop-service",
    "allow-resume-session",
    "allow-stop-session",
    "allow-list-focus-rules",
    "allow-save-focus-rule",
    "allow-delete-focus-rule",
    "allow-set-focus-rules-enabled",
    "allow-focus-current-app",
    "allow-display-settings",
    "allow-set-display-settings",
    "allow-switch-session-profile",
    "allow-session-profile",
    "allow-create-diagnostics",
    "allow-prepare-artwork",
    "allow-save-artwork"
  ]
}
