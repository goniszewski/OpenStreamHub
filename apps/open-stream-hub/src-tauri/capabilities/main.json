{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local profile editing, device-free replay, and read-only device input feeds, supervised masterhub-service action runs, local diagnostic bundles, and offline display artwork preparation in the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "allow-bootstrap",
    "allow-list-profiles",
    "allow-load-profile",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-validate-profile",
    "allow-export-profile",
    "allow-replay-demo",
    "allow-preview-binding",
    "allow-preview-keypad",
    "allow-list-live-devices",
    "allow-start-feed",
    "allow-stop-feed",
    "allow-start-service",
    "allow-stop-service",
    "allow-create-diagnostics",
    "allow-prepare-artwork",
    "allow-save-artwork"
  ]
}
