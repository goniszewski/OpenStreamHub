    "allow-replay-demo",
    "allow-preview-binding",
    "allow-preview-keypad",
    "allow-list-live-devices",
    "allow-start-feed",
    "allow-stop-feed",
    "allow-set-dial-lighting",
    "allow-set-led-lighting",
    "allow-list-base-modules",
    "allow-reset-dial-lighting",
    "allow-start-service",
    "allow-stop-service",
    "allow-resume-session",
