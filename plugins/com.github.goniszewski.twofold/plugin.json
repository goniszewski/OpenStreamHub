{
  "schema": 1,
  "id": "com.github.goniszewski.twofold",
  "name": "Twofold",
  "version": "1.0.0",
  "command": ["/usr/bin/python3", "plugin.py"],
  "actions": [
    {
      "id": "tile",
      "label": "Board key",
      "events": true,
      "image": true,
      "params": []
    },
    {
      "id": "move",
      "label": "Move",
      "params": [
        {
          "id": "direction",
          "label": "Direction",
          "type": "choice",
          "default": "up",
          "choices": [
            { "id": "up", "label": "Up" },
            { "id": "down", "label": "Down" },
            { "id": "left", "label": "Left" },
            { "id": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "permissions": { "network": [], "programs": false }
}
